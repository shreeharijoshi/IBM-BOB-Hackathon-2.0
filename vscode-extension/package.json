{
  "name": "cpp-diagnostic",
  "displayName": "C++ Diagnostic",
  "description": "Analyze C++ compiler errors with precise root-cause locations and Gemini AI code review directly inside VS Code.",
  "version": "0.3.0",
  "publisher": "ibm-bob-hackathon",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibm-bob-hackathon/cpp-diagnostic"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "C++",
    "GCC",
    "Clang",
    "diagnostic",
    "compiler",
    "error",
    "gemini",
    "ai"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cppDiagnostic.diagnose",
        "title": "Diagnose C++: Explain Error",
        "category": "C++ Diagnostic"
      },
      {
        "command": "cppDiagnostic.analyzeFile",
        "title": "Diagnose C++: Analyze File",
        "category": "C++ Diagnostic"
      },
      {
        "command": "cppDiagnostic.checkCode",
        "title": "Context Diagnostic: Check Code with Gemini",
        "category": "C++ Diagnostic"
      },
      {
        "command": "cppDiagnostic.clearDiagnostics",
        "title": "Diagnose C++: Clear Diagnostics",
        "category": "C++ Diagnostic"
      },
      {
        "command": "cppDiagnostic.showPanel",
        "title": "Diagnose C++: Show Explanation Panel",
        "category": "C++ Diagnostic"
      },
      {
        "command": "cppDiagnostic.setGeminiApiKey",
        "title": "Diagnose C++: Set Gemini API Key",
        "category": "C++ Diagnostic"
      },
      {
        "command": "cppDiagnostic.clearGeminiApiKey",
        "title": "Diagnose C++: Clear Gemini API Key",
        "category": "C++ Diagnostic"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "command": "cppDiagnostic.diagnose",
          "group": "navigation@1"
        },
        {
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "command": "cppDiagnostic.checkCode",
          "group": "navigation@2"
        },
        {
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "command": "cppDiagnostic.analyzeFile",
          "group": "navigation@3"
        },
        {
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx",
          "command": "cppDiagnostic.clearDiagnostics",
          "group": "navigation@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cppDiagnostic.diagnose",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus && (resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx)"
      },
      {
        "command": "cppDiagnostic.checkCode",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus && (resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx)"
      },
      {
        "command": "cppDiagnostic.clearDiagnostics",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx"
      }
    ],
    "configuration": {
      "title": "C++ Diagnostic",
      "properties": {
        "cppDiagnostic.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter used to run the diagnostic backend. Defaults to 'python' (uses the system PATH)."
        },
        "cppDiagnostic.backendUrl": {
          "type": "string",
          "default": "",
          "description": "Optional URL of a running backend server (e.g. http://localhost:8000). When set, the extension communicates via HTTP instead of spawning the Python CLI adapter."
        },
        "cppDiagnostic.autoAnalyzeOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically analyze C++ files when saved."
        },
        "cppDiagnostic.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional Google Gemini API key for AI code analysis and complex error resolution. If empty, uses GEMINI_API_KEY environment variable if present. Deterministic rules always work without a key."
        },
        "cppDiagnostic.geminiModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Google Gemini model to use (default: gemini-2.5-flash)."
        },
        "cppDiagnostic.geminiEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Gemini AI features (falls back to offline rules when disabled or unconfigured)."
        },
        "cppDiagnostic.geminiTimeout": {
          "type": "number",
          "default": 15,
          "description": "Timeout in seconds for Gemini requests."
        },
        "cppDiagnostic.preferGemini": {
          "type": "boolean",
          "default": true,
          "description": "When a Gemini API key is provided, use Gemini AI-driven explanations for all diagnostics. Falls back to offline rules if unconfigured or unavailable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "copy-backend": "node -e \"const fs=require('fs'),path=require('path'),src=path.join(__dirname,'..','backend'),dst=path.join(__dirname,'backend');fs.rmSync(dst,{recursive:true,force:true});fs.cpSync(src,dst,{recursive:true});\"",
    "vscode:prepublish": "npm run copy-backend && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
