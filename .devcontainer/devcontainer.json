{
  "name": "C++ Compiler Diagnostic Helper",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {},
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools"
      ],
      "settings": {
        "cppDiagnostic.preferGemini": true,
        "cppDiagnostic.autoAnalyzeOnSave": true,
        "cppDiagnostic.backendUrl": "http://127.0.0.1:8000"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
